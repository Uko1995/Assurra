# EaaS Platform - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# CRITICAL: SECURITY CONFIGURATION
# ============================================================================

# JWT Secret - MUST be at least 32 characters for HS256
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Gateway Internal Signing Secret - Used for service-to-service request signing
# MUST be the same across all services (gateway + all backend services)
# Generate: openssl rand -base64 32
GATEWAY_SIGNING_SECRET=internal-gateway-signing-secret-change-in-production

# ============================================================================
# SQL Server LocalDB Configuration
# ============================================================================
MSSQL_URL=localhost:1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong@Passw0rd

# Optional: Connection settings
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_SERVER_CERTIFICATE=true
# MSSQL_LOGIN_TIMEOUT=30

# ============================================================================
# Service Database Names (change if using different database names)
# ============================================================================
# MSSQL_IDENTITY_DB=identity_db
# MSSQL_ESCROW_DB=escrow_db
# MSSQL_PAYMENT_DB=payment_db
# MSSQL_COMMUNICATION_DB=communication_db

# ============================================================================
# JWT Configuration (Identity Service)
# ============================================================================
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ============================================================================
# Interswitch Payment API (Payment Service)
# ============================================================================
INTERSWITCH_API_URL=https://sandbox.interswitchng.com
INTERSWITCH_API_KEY=your-interswitch-key
INTERSWITCH_API_SECRET=your-interswitch-secret
INTERSWITCH_WEBHOOK_SECRET=your-webhook-secret

# ============================================================================
# SendGrid Email (Communication Service)
# ============================================================================
SENDGRID_API_KEY=your-sendgrid-api-key
MAIL_FROM=noreply@eaas.africa

# ============================================================================
# Termii SMS (Communication Service)
# ============================================================================
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=EaaS

# ============================================================================
# AWS S3 (Communication Service - Evidence Storage)
# ============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=af-south-1
AWS_S3_BUCKET=eaas-evidence

# ============================================================================
# Redis Configuration (Identity & Escrow Services)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ============================================================================
# RabbitMQ Configuration (All Services)
# ============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=eaas_user
RABBITMQ_PASS=eaas_pass

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Replenish rate: tokens per second
RATE_LIMIT_REPLENISH_RATE=10
# Burst capacity: maximum tokens
RATE_LIMIT_BURST_CAPACITY=150


CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


ENCRYPTION_MASTER_KEY=your_encryption_master_key